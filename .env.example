# Provedor de LLM ativo. Hoje só "openai" está implementado em lib/llm/provider.ts.
LLM_PROVIDER=openai

# Chave da API da OpenAI. Gere em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo usado (opcional). Default: gpt-4o-mini (bom custo-benefício para portfólio).
OPENAI_MODEL=gpt-4o-mini
