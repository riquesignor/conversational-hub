# Provedor de LLM ativo. Implementados em lib/llm/provider.ts: "google" | "openai".
# Default "google" (Gemini) porque o free tier não exige cartão de crédito.
LLM_PROVIDER=google

# --- Google Gemini (default, gratuito) ---
# Gere em https://aistudio.google.com/apikey — não pede cartão para o tier free.
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo (opcional). Default: gemini-3.5-flash.
GOOGLE_MODEL=gemini-3.5-flash

# --- OpenAI (opcional — exige cartão cadastrado mesmo para o crédito de teste) ---
# Só preencha se decidir usar LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend de persistência de conversas. Implementados em lib/db/index.ts:
# "memory" (default, sem configuração nenhuma, mas não sobrevive a
# cold start/redeploy) | "firebase" (ver lib/db/firebase-store.ts para o
# passo a passo — ainda não implementado, só o esqueleto).
DB_PROVIDER=memory

# --- Firebase (opcional, ver lib/db/firebase-store.ts) ---
# Só preencha depois de: 1) rodar `npm install firebase-admin`, 2) implementar
# a classe comentada em lib/db/firebase-store.ts, 3) definir DB_PROVIDER=firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
